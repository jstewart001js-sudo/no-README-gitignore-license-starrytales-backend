# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string, e.g. from Render/Railway/Supabase
DATABASE_URL=postgres://user:password@host:5432/starrytales
PGSSL=true

# Random long string used to sign login sessions (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_long_random_string

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Only needed if the key above is an identity-linked key (error mentions
# "anthropic-workspace-id is required"). Find it in the Console URL while
# viewing your workspace, e.g. console.anthropic.com/settings/workspaces/<this-id>
ANTHROPIC_WORKSPACE_ID=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...   # the recurring $7.99/mo Price you create in Stripe

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM="StarryTales <stories@yourdomain.com>"

# Public URL of this deployed app (used for Stripe redirect URLs)
APP_URL=https://your-domain.com

PORT=4000
ENABLE_SCHEDULER=true
